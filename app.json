{
  "expo": {
    "name": "Wedflow",
    "slug": "wedflow-ai",
    "version": "0.1.0",
    "scheme": "wedflow",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.wedflowai.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "pavanjhariya211s-team",
    "extra": {
      "eas": {
        "projectId": "27914ae3-994f-40c7-aba8-8369b6eea723"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
