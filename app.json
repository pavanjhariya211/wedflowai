{
  "expo": {
    "name": "Wedflow",
    "slug": "wedflowai",
    "version": "0.1.0",
    "scheme": "wedflow",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
